+
+def _neighbors(r: int, c: int, height: int, width: int, diagonal: bool) -> list[tuple[int, int]]:
+    steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    if diagonal:
+        steps += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+    return [(r + dr, c + dc) for dr, dc in steps if 0 <= r + dr < height and 0 <= c + dc < width]
+
+
+def campsite_verifier_pass(grid: list[list[str]] | None, expected: list[list[str]] | None) -> bool:
+    """Official Campsite rules, reading only what the puzzle shows (taken from `expected` exactly as the
+    projections do: its shape, tree cells and tent row/column counts): trees unchanged, tent counts per
+    row and column, no two tents touching (8-neighbourhood), and a perfect tent-tree matching."""
+    if grid is None or expected is None or grid_shape(grid) != grid_shape(expected):
+        return False
+    height, width = grid_shape(expected)
+    if any(len(row) != width or any(cell not in ("T", "C", "X") for cell in row) for row in grid):
+        return False
+    if any((grid[r][c] == "T") != (expected[r][c] == "T") for r in range(height) for c in range(width)):
+        return False
+    if not signature_pass(grid, expected, "C"):
+        return False
+    tents = [(r, c) for r in range(height) for c in range(width) if grid[r][c] == "C"]
+    if any(grid[rr][cc] == "C" for r, c in tents for rr, cc in _neighbors(r, c, height, width, True)):
+        return False
+    match: dict[tuple[int, int], tuple[int, int]] = {}
+
+    def assign(tent: tuple[int, int], seen: set[tuple[int, int]]) -> bool:
+        for tree in _neighbors(*tent, height, width, False):
+            if grid[tree[0]][tree[1]] != "T" or tree in seen:
+                continue
+            seen.add(tree)
+            if tree not in match or assign(match[tree], seen):
+                match[tree] = tent
+                return True
+        return False
+
+    trees = sum(cell == "T" for row in grid for cell in row)
+    return len(tents) == trees and all(assign(tent, set()) for tent in tents)
+
